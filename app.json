{
  "expo": {
    "name": "Echo",
    "slug": "echo-daylog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#ECEAE3"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.echodaylog.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "Daylog uses notifications to remind you of active tasks.",
        "UIBackgroundModes": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ECEAE3"
      },
      "package": "com.echodaylog.app",
      "versionCode": 1
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#7C5CFC"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e0f788ac-3c3a-452a-b474-ea76b002821e"
      }
    },
    "owner": "appdevlaura"
  }
}
